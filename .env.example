# --- BANCO DE DADOS (Postgres) ---
# Ex.: postgres://usuario:senha@host:5432/nome_do_banco
# Neon/Supabase/Render normalmente exigem SSL: defina PGSSL=require
DATABASE_URL=
PGSSL=

EMAIL_USER=lucas@virgulacontabil.com.br
EMAIL_PASS=

# --- AUTENTICAÇÃO ---
# USERS[0]/PASSWORDS[0] só são usados no PRIMEIRO boot para criar o agente "admin".
# Depois disso a gestão de colaboradores é feita pela aba Configurações > Usuários.
USERS=lucas
PASSWORDS=
# Segredo para assinar os JWT (obrigatório em produção). Gere um aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# URL pública do sistema, usada nos links de convite por e-mail:
APP_BASE_URL=http://localhost:3000
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_FROM_NAME=Lucas Araujo | Vírgula Contabil
GEMINI_API_KEY=
SENT_FOLDER=INBOX.Sent
IMAP_HOST=imap.hostinger.com

# --- GOOGLE CALENDAR ---
# Para conectar seu Google Calendar diretamente, siga os passos:
# 1. Acesse o Google Cloud Console (console.cloud.google.com)
# 2. Crie um projeto e ative a "Google Calendar API"
# 3. Vá em "Credentials" (Credenciais) > Create Credentials > OAuth client ID (Web application ou Desktop)
# 4. Use o OAuth Playground (developers.google.com/oauthplayground) para obter o Refresh Token com o escopo:
#    https://www.googleapis.com/auth/calendar
# 5. Preencha as três variáveis abaixo:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
