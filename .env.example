# --- BANCO DE DADOS (Postgres) ---
# Ex.: postgres://usuario:senha@host:5432/nome_do_banco
# Neon/Supabase/Render normalmente exigem SSL: defina PGSSL=require
DATABASE_URL=
PGSSL=

EMAIL_USER=lucas@virgulacontabil.com.br
EMAIL_PASS=

# --- AUTENTICAÇÃO ---
# USERS[0]/PASSWORDS[0] só são usados no PRIMEIRO boot para criar o agente "admin".
# Depois disso a gestão de colaboradores é feita pela aba Configurações > Usuários.
USERS=lucas
PASSWORDS=
# Segredo para assinar os JWT (obrigatório em produção). Gere um aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# URL pública do sistema, usada nos links de convite por e-mail.
# Se vazio, é derivada dos cabeçalhos do request (X-Forwarded-Proto/Host do proxy).
# RECOMENDADO definir em produção, ex.:
# APP_BASE_URL=https://pmsgc-contabil.wvai75.easypanel.host
APP_BASE_URL=
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
# Remetente PADRÃO (usado quando o colaborador não tem alias definido no cadastro).
EMAIL_FROM_NAME=Lucas Araujo | Vírgula Contabil
# EMAIL_FROM_EMAIL=  # opcional: endereço do "From" padrão; em branco usa EMAIL_USER
GEMINI_API_KEY=
SENT_FOLDER=INBOX.Sent
IMAP_HOST=imap.hostinger.com

# --- WHATSAPP (opcional) ---
# Caminho do Chromium dentro do container (o Dockerfile já define; só mude se necessário).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
#
# Trava a versão do WhatsApp Web. DEIXE VAZIO por padrão — o WhatsApp Web é
# carregado ao vivo, que é o mais compatível. Só preencha se, DEPOIS de uma
# atualização do WhatsApp, a conexão passar a dar "Evaluation failed"/getChats
# quebrando logo ao conectar. O valor a usar é o que aparece no log
# "[WhatsApp] WhatsApp Web versão em uso: <X>" de quando estava funcionando,
# e precisa existir em github.com/wppconnect-team/wa-version/tree/main/html
# WA_WEB_VERSION=

# --- GOOGLE CALENDAR ---
# Para conectar seu Google Calendar diretamente, siga os passos:
# 1. Acesse o Google Cloud Console (console.cloud.google.com)
# 2. Crie um projeto e ative a "Google Calendar API"
# 3. Vá em "Credentials" (Credenciais) > Create Credentials > OAuth client ID (Web application ou Desktop)
# 4. Use o OAuth Playground (developers.google.com/oauthplayground) para obter o Refresh Token com o escopo:
#    https://www.googleapis.com/auth/calendar
# 5. Preencha as três variáveis abaixo:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
